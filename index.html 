<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MPU9250 Live</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        body{
            font-family:'Segoe UI',sans-serif;
            background:linear-gradient(135deg,#0a0e17,#1a1f2b);
            min-height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            padding:10px;
            color:#fff;
        }
        .dash{
            width:100%;
            max-width:550px;
        }
        .header{
            text-align:center;
            margin-bottom:15px;
        }
        .header h1{
            font-size:1.5em;
            color:#00d4ff;
            margin-bottom:5px;
        }
        .status{
            font-size:0.75em;
            padding:3px 12px;
            border-radius:12px;
        }
        .status.on{background:rgba(0,255,0,0.15);color:#0f0;animation:pulse 2s infinite}
        .status.off{background:rgba(255,0,0,0.15);color:#f44}
        @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.5}}
        .grid{
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:8px;
        }
        .card{
            background:linear-gradient(135deg,#1a1f2b,#222935);
            border:1px solid #2a3040;
            border-radius:10px;
            padding:12px;
            text-align:center;
            transition:0.2s;
        }
        .card:hover{
            border-color:#00d4ff;
            transform:translateY(-2px);
        }
        .card .label{
            font-size:0.65em;
            color:#7a8a9a;
            text-transform:uppercase;
            letter-spacing:1px;
            margin-bottom:6px;
        }
        .card .value{
            font-size:1.6em;
            font-weight:700;
            color:#00d4ff;
            word-break:break-all;
        }
        .card .unit{
            font-size:0.5em;
            color:#5a6a7a;
            display:block;
            margin-top:2px;
        }
        .footer{
            text-align:center;
            color:#3a4a5a;
            font-size:0.65em;
            margin-top:12px;
        }
    </style>
</head>
<body>
    <div class="dash">
        <div class="header">
            <h1>MPU9250 Sensor</h1>
            <span class="status off" id="st">● DISCONNECTED</span>
        </div>
        <div class="grid">
            <div class="card">
                <div class="label">Accel X</div>
                <div class="value" id="ax">0.0000</div>
                <div class="unit">m/s²</div>
            </div>
            <div class="card">
                <div class="label">Accel Y</div>
                <div class="value" id="ay">0.0000</div>
                <div class="unit">m/s²</div>
            </div>
            <div class="card">
                <div class="label">Accel Z</div>
                <div class="value" id="az">9.8100</div>
                <div class="unit">m/s²</div>
            </div>
            <div class="card">
                <div class="label">Gyro X</div>
                <div class="value" id="gx">0.0000</div>
                <div class="unit">°/s</div>
            </div>
            <div class="card">
                <div class="label">Gyro Y</div>
                <div class="value" id="gy">0.0000</div>
                <div class="unit">°/s</div>
            </div>
            <div class="card">
                <div class="label">Gyro Z</div>
                <div class="value" id="gz">0.0000</div>
                <div class="unit">°/s</div>
            </div>
        </div>
        <div class="footer">ESP32 → HiveMQ → Vercel</div>
    </div>
    <script src="https://unpkg.com/mqtt/dist/mqtt.min.js"></script>
    <script>
        const c=mqtt.connect('wss://2ee891c830dc45a681af9ac25a765978.s1.eu.hivemq.cloud:8884/mqtt',{
            username:'MPU9060',
            password:'Mpu6090mpu',
            reconnectPeriod:3000
        });
        c.on('connect',()=>{
            document.getElementById('st').textContent='● CONNECTED';
            document.getElementById('st').className='status on';
            c.subscribe('mpu9250/sensor');
        });
        c.on('message',(t,m)=>{
            try{
                const d=JSON.parse(m.toString());
                document.getElementById('ax').textContent=d.ax.toFixed(4);
                document.getElementById('ay').textContent=d.ay.toFixed(4);
                document.getElementById('az').textContent=d.az.toFixed(4);
                document.getElementById('gx').textContent=d.gx.toFixed(4);
                document.getElementById('gy').textContent=d.gy.toFixed(4);
                document.getElementById('gz').textContent=d.gz.toFixed(4);
            }catch(e){}
        });
        c.on('close',()=>{
            document.getElementById('st').textContent='● DISCONNECTED';
            document.getElementById('st').className='status off';
        });
    </script>
</body>
</html>